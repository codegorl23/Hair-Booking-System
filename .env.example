# Database — get connection string from your PostgreSQL provider
DATABASE_URL= postgresql://postgres.<your-supabase-project-ref>:<your-db-password>@aws-1-us-east-1.pooler.supabase.com:5432/postgres

# Authentication — use a long random string in production
JWT_SECRET_KEY= your-jwt-secret-key-min-32-chars-long

# Environment — development or production
FLASK_ENV= development or production